  keystones:
  - stableId: tree.v3.class.priest.keystone.priestsacrifice
    logicalSlotId: tree.v3.class.priest.keystone.priestsacrifice
    displayName: Ailment Sacrifice
    description: Cannot apply Poison, Bleed or Ignite. Each distinct type a hit successfully would apply loses 5% target maximum Life; at most 15% per hit. Counts for damage-based healing.
    branch: 8
    size: 2
    kind: 4
    keystone: 34
    effects: []
    iconMode: 1
    iconOverride: {fileID: 21300000, guid: 515daee52d8470c4da2c894c21392536, type: 3}
  - stableId: tree.v3.class.priest.keystone.priestaura
    logicalSlotId: tree.v3.class.priest.keystone.priestaura
    displayName: Prismatic Discipline
    description: 20% Aura Effect per active aura. Hits with more than two damage types randomly retain only two types, independently each hit.
    branch: 8
    size: 2
    kind: 4
    keystone: 35
    effects: []
    iconMode: 1
    iconOverride: {fileID: 21300000, guid: 515daee52d8470c4da2c894c21392536, type: 3}
  - stableId: tree.v3.class.priest.keystone.priestfracture
    logicalSlotId: tree.v3.class.priest.keystone.priestfracture
    displayName: Deep Fracture
    description: 'Freeze only at 200% Chill Effect for one attack opportunity, then permanently Fracture: 25% more damage taken, no further Freeze or Shatter.'
